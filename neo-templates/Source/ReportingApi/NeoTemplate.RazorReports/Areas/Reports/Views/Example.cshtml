@using NonFactors.Mvc.Grid;
@using Neo.Reporting;
@using NeoTemplate.RazorReports;
@using NeoTemplate.Models.Reports.Example;

@model ReportInstance<EmptyCriteria, ExampleReportModel>

<style>

  table {
    page-break-inside: auto
  }

  tr {
    page-break-inside: avoid;
    page-break-after: auto
  }

  thead {
    display: table-header-group
  }

  tfoot {
    display: table-footer-group
  }
</style>

<div class="report-view">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">

  <div class="example-data">
    @(Html
          .Grid(Model.ReportModel.Data)
          .Build(columns =>
          {
            columns.Add(model => model.ExampleReportDataId).Titled("Id");
            columns.Add(model => model.Name);
            columns.Add(model => model.CreatedMonth);
            columns.Add(model => model.CreatedOn);
          })
          .Empty("No data found")
          .Css("print-friendly")
          .AppendCss("table-hover"))
  </div>

  <script>
    document.querySelectorAll(".mvc-grid").forEach(element => new MvcGrid(element));
  </script>
</div>

