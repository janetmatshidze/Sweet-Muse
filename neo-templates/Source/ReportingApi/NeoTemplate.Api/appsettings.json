{
  "ConnectionStrings": {
    "Main": "Server={KeyVault:SqlServerName};Initial Catalog=NeoTemplate.Reporting;Persist Security Info=False;User ID={KeyVault:SqlUserName};Password={KeyVault:SqlPassword};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "App": {
    "Title": "Reporting Test WebApi",
    "Version": "1.0.0",
    "ApiVersion": "1.0"
  },
  "ReportingService": {
    "BaseUrl": "{scheme}://{host}:5100"
  },
  "Authentication": {
    "AuthenticationAuthorityUrl": "https://localhost:5000",
    "AuthorizationUrl": "https://localhost:5000/connect/authorize",
    "TokenUrl": "https://localhost:5000/connect/token",
    // You will need to add this client to your IdentityServer before running this project.
    "ClientId": "NeoTemplate.Reporting",
    "ClientSecret": "{KeyVault:ApiClientSecrets:Reporting}"
  },
  "Authorisation": {
    "AuthorizationServiceUrl": "https://localhost:5999/api/",
    "AuthorizationTenantCode": "NeoTemplate"
  },
  "NotificationServer": {
    "EndPoint": "https://localhost:6001/api/"
  },
  "KeyVaults": [
    {
      "Key": "Main",
      "Name": "NeoTemplate.KeyVault",
      "AuthenticationMethod": "DefaultCredential",
      "Enabled": false,
      "AddAsConfigProvider": true,
      "InjectSecrets": true
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiResource": {
    "ResourceName": "Reporting"
  },
  "Swagger": {
    "Scopes": {
      "Reporting": "Reporting WebApi - full access"
    }
  }
}
