{
  "ConnectionStrings": {
    "Main": "Server={KeyVault:SqlServerName};Initial Catalog=NeoTemplate;Persist Security Info=False;User ID={KeyVault:SqlUserName};Password={KeyVault:SqlPassword};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "App": {
    "Title": "NeoTemplate WebApi",
    "Version": "1.0.0",
    "ApiVersion": "1.0"
  },
  "Authentication": {
    "AuthenticationAuthorityUrl": "https://localhost:5000",
    "AuthorizationUrl": "https://localhost:5000/connect/authorize",
    "TokenUrl": "https://localhost:5000/connect/token",
    // You will need to add this client to your IdentityServer before running this project.
    "ClientId": "NeoTemplate",
    "ClientSecret": "{KeyVault:ApiClientSecrets:NeoTemplate}"
  },
  "KeyVaults": [
    {
      "Key": "Main",
      "Name": "NeoTemplate.KeyVault",
      "AuthenticationMethod": "DefaultCredential",
      "Enabled": false,
      "AddAsConfigProvider": true,
      "InjectSecrets": true
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiResource": {
    "ResourceName": "api1"
  },
  "Swagger": {
    "Scopes": {
      "api1": "NeoTemplateServiceName WebApi - full access"
    }
  }
}
