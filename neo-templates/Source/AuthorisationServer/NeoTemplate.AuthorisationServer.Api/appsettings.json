{
  // --------------------------------------------------------------------------
  // Neo Authorisation Server AppSettings
  // --------------------------------------------------------------------------

  // IMPORTANT
  //   The appsettings.json file should be used for 'sensible defaults' to use when the application is deployed. (I.e. General settings for 'Staging' and 'Production' scenarios)
  //   Settings specifically for local development should be added to appsettings.Development.json.

  // The following properties must be set in your deployment configuration:
  //  - ConnectionStrings.Main                               (Set the SQL Server name, database name with project and environment prefixes)
  //  - AuthorisationServer.Authentication.AuthorityUrl
  //  - AuthorisationServer.Authentication.AuthorizationUrl
  //  - AuthorisationServer.Authentication.TokenUrl
  //  - AuthorisationServer.MultiTenancy                     (If using MultiTenancy)
  //  - IdentityService.EndPointUrl
  //  - KeyVaults[0].Name

  // --------------------------------------------------------------------------
  // Application Configuration
  // --------------------------------------------------------------------------
  "App": {
    "Title": "NeoTemplate Authorisation Api",
    "Version": "1.0.0",
    "ApiVersion": "1.0"
  },
  "ConnectionStrings": {
      // Set this value in your deployment config yaml files. (E.g: Server=scstgvmsql01;Initial Catalog=NS.QA.AuthorisationServer;User ID={KeyVault:SqlAppUsername};Password={KeyVault:SqlAppPassword};Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;Column Encryption Setting=Enabled;MultipleActiveResultSets=True;Persist Security Info=True;)
      "Main": ""
  },
  "Routing": {
    "ForwardedHeaders": {
      "Headers": "XForwardedFor,XForwardedProto,XForwardedHost"
    },
    "PathBase": "/authorisation-server",
    "AppFolder": ""
  },
  "AllowedHosts": "*",
  "AuthorisationServer": {
    "Code": "NeoTemplate",
    "Name": "NeoTemplate",
    "Publication": {
      // TODO: This needs to be updated to the client's provisioned Service Bus, in their App YAML config file.
      "FullyQualifiedNamespace": ""
    },
    "Authentication": {
      // Set this value in your deployment config yaml files. (E.g: https://sample.your-domain.com/identity-server)
      "AuthorityUrl": "",
      // Set this value in your deployment config yaml files. (E.g: https://sample.your-domain.com/identity-server/connect/authorize)
      "AuthorizationUrl": "",
      // Set this value in your deployment config yaml files. (E.g: https://sample.your-domain.com/identity-server/connect/token)
      "TokenUrl": "",
      "DiscoveryRequiresHttps": false,
      "ResourceName": "Authorisation",
      "ClientId": "NeoTemplate.AuthorisationServer",
      "ClientSecret": "{KeyVault:ApiClientSecrets:AuthorisationServer}",
      "Scope": "IdentityServerApi"
    },
    "MultiTenancy": {
      "IsMultiTenant": false,
      // Set this value in your deployment config yaml files. E.g. http://sample.domain.com/clients/api/
      "EndPointUrl": "",
      "TenantsPath": "NeoTemplate/Tenants",
      "DeferInitialisation": true,
      "ServiceBus": {
        // TODO: This needs to be updated to the client's provisioned Service Bus, in their App YAML config file.
        "FullyQualifiedNamespace": "",
        "TopicPath": "NeoTemplate-Tenant-Changes",
        "SubscriptionName": "Authorisation"
      }
    }    
  },
  "IdentityService": {
      // Set this value in your deployment config yaml files. (E.g: https://sample.domain.com/identity-server)
      "EndPointUrl": ""
  },
  "Enrolment": {
    // Users with this user name will automatically become administrators.
    "Administrators": [ "alice@test.com", "bob@test.com" ]
  },
  "Swagger": {
    "Enabled": true,
    "RequireAuthorisationByDefault": true,
    "Scopes": {
      "Authorisation": "NeoTemplate Authorisation WebApi - full access"
    }
  },
  "SwaggerClient": {
    "ClientId": "swaggerClient"
  },

  // --------------------------------------------------------------------------
  // External Services
  // --------------------------------------------------------------------------
  "KeyVaults": [
    {
      "Key": "Main",
      // Set this value in your deployment config yaml files. E.g. ns-qa-kv-main
      "Name": "n/a",
      "AuthenticationMethod": "DefaultCredential",
      "Enabled": true,
      "AddAsConfigProvider": true,
      "InjectSecrets": true
    }
  ],

  // --------------------------------------------------------------------------
  // Logging
  // --------------------------------------------------------------------------
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "Cleanup": {
      "Schedule": "0 0 2 1/1 * ? *", // 2am every day
      "DefaultDays": 30,
      "Levels": [
        {
          "Level": "Fatal",
          "Days": 180
        },
        {
          "Level": "Error",
          "Days": 180
        },
        {
          "Level": "Warning",
          "Days": 60
        }
      ]
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // Note: These namespaces have been overridden to make standard app logging less noisy.If you need to debug something that's
        //       being suppressed by these overrides, such as the SQL statements being generated by EF Core, you can drop the log level
        //       by overriding these base settings in the appsettings.Development.json file.
        "System": "Warning",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      "MSSqlServer": {
        "Name": "MSSqlServer",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "connectionString": "Main",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlDatabase": true,
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "Source",
                "PropertyName": "SourceContext",
                "DataType": "varchar",
                "DataLength": 200
              }
            ],
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "logEvent": {
              "excludeAdditionalProperties": true,
              "excludeStandardColumns": true
            }
          }
        }
      }
    }
  },
  // Logging Middleware
  //   These can be used to enable additional logging around authentication, requests/responses and multi-tenancy.
  //   NOTE: Leaving these enabled on a live environment is not recommended, as they add a lot of noise to the logs, and may also impact performance.
  "Middleware": {
    "AuthenticationInfoLogging": {
      "Enabled": false
    },
    "RequestResponseLogging": {
      "Enabled": false
    },
    "MultiTenancyInfoLogging": {
      "Enabled": false
    }
  }
}
