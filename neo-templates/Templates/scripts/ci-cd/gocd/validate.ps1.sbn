{{ # This is a Scriban Template (https://github.com/scriban/scriban) }}
Invoke-NeoGoCdYamlValidation `
  -Path $PSScriptRoot `
  -ConfigRepositoryName {{ iac.repoUrl | regex.match "(?<=/)(.*)(?=.git)" | array.first }} `
  -RemoveTempFile $true `
  -FormatVersion 9 `
  -Verbose `
  -InformationAction:Continue
