{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "NeoTemplate.Api": {
      "commandName": "Project",
      "launchBrowser": false,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "https://localhost:5002"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://host.docker.internal:{ServicePort}",
      "publishAllPorts": true,
      "useSSL": true,
      "sslPort": 5002,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DEBUG_ENVIRONMENT": "Docker"
      }
    }
  }
}