{
  "$schema": "http://json.schemastore.org/template",
  "author": "Singular Systems",
  "classifications": [ "WebApi", "Model" ],
  "identity": "NeoTemplate.WebApi",
  "name": "Neo WebApi",
  "shortName": "neoapi",
  "preferNameDirectory": false,
  "sourceName": "NeoTemplate",
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ ".vs/**" ]
        }
      ]
    }
  ],
  "symbols": {
    "serviceName": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "replaces": "NeoTemplateServiceName",
      "fileRename": "NeoTemplateServiceName"
    },
    "aggregateRoot": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "replaces": "AggregateRoot",
      "fileRename": "AggregateRoot"
    }
  }
}