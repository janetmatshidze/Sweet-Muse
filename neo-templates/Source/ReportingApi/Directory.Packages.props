<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Flurl.Http" Version="4.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Neo.Azure.KeyVault" Version="10.3.102" />
    <PackageVersion Include="Neo.Identity.Api" Version="10.3.102" />
    <PackageVersion Include="Neo.Model.App" Version="10.3.102" />
    <PackageVersion Include="Neo.Model.SqlServer" Version="10.3.102" />
    <PackageVersion Include="Neo.Model.Swagger" Version="10.3.102" />
    <PackageVersion Include="Neo.Model.Testing" Version="10.3.102" />
    <PackageVersion Include="Neo.Reporting.Api" Version="10.3.102" />
    <PackageVersion Include="Neo.Reporting.IronPdf2022" Version="10.3.102" />
    <PackageVersion Include="Neo.Reporting.Models" Version="10.3.102" />
    <PackageVersion Include="Neo.Reporting.Notifications" Version="10.3.102" />
    <PackageVersion Include="NonFactors.Grid.Mvc6" Version="6.2.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Neo.Analyzers" Version="10.1.101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </GlobalPackageReference>
  </ItemGroup>
</Project>